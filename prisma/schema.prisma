generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // يمكنك تغييرها إلى "postgresql" لاحقاً لدعم 10 آلاف مستخدم
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  phoneNumber  String   @unique // رقم الهاتف للاتصال
  username     String   // الاسم المعروض
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String   // رقم المرسل
  targetId  String   // رقم المستقبل
  createdAt DateTime @default(now())
}
