generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  phoneNumber  String   @unique
  username     String
  passwordHash String?
  secretToken  String   @unique // 🔑 الملف السري
  role         String   @default("user")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  phoneNumber  String   @unique
  username     String
  passwordHash String?  // اختياري
  role         String   @default("user")
  deviceToken  String   @unique @default(uuid()) // 🔑 الملف السري
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  targetId  String
  createdAt DateTime @default(now())
}
