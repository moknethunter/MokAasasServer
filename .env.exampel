# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
VERSION=0.1.0
LOG_LEVEL=info

# Admin (السيرفر مغلق — مدير واحد)
# ولّد الهاش: npm run hash-password "كلمة-سر-قوية"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$REPLACE_WITH_HASH_FROM_SCRIPT
SESSION_SECRET=change-me-to-64-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_TTL_HOURS=8

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice?schema=public

# Features
FEATURE_CHAT=false
FEATURE_CALLS=false
FEATURE_AI=false
FEATURE_AUDIT=false
